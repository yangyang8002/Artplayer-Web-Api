{
  "name": "open-video-api",
  "version": "26.8.11",
  "description": "OpenVideoAPI - self-hosted danmaku video player with web admin: PoW firewall, rate limiting, multi-theme, plugin system (Koishi-style), subtitle support, multi-database storage",
  "main": "server.js",
  "bin": {
    "open-video-api": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "pack": "npm pack --dry-run",
    "prepublishOnly": "npm pack --dry-run"
  },
  "files": [
    "server.js",
    "lib/",
    "public/",
    "theme/",
    "plugins/",
    "gen_perf_danmu.js",
    "nginx.conf.example",
    "README.md",
    "README_CN.md",
    "README_EN.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangyang8002/OpenVideoAPI.git"
  },
  "keywords": [
    "openvideo",
    "danmaku",
    "video",
    "player",
    "express",
    "admin",
    "plugin",
    "sqlite",
    "mysql",
    "postgresql",
    "database"
  ],
  "author": "yangyang8002",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "basic-ftp": "^6.2.0",
    "better-sqlite3": "^11.10.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ip2region": "^2.3.0",
    "ip2region.js": "^3.1.8",
    "mongodb": "^6.21.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "ssh2-sftp-client": "^12.1.1",
    "webdav": "^5.10.0"
  }
}
